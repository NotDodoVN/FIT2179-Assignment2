{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 400,
  "height": 225,
  "title": {
    "text": "Projected Crop Production (2025-26)",
    "subtitle": "Bars show production volume (kt)",
    "fontSize": 16,
    "fontWeight": "bold",
    "subtitleFontSize": 13,
    "subtitleColor": "gray",
    "anchor": "start"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/NotDodoVN/FIT2179-Assignment2/refs/heads/main/Datasets%20-%20wrangled/Graph%209%20(25-26)-touse.csv"
  },
  "resolve": {
    "scale": { "y": "independent" }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusTopLeft": 4,
        "cornerRadiusTopRight": 4
      },
      "encoding": {
        "x": {
          "field": "Crop",
          "type": "nominal",
          "axis": { "title": "Crop", "labelAngle": 0 }
        },
        "y": {
          "field": "Production (kt)",
          "type": "quantitative",
          "axis": {
            "title": "Production (kt)"
          }
        },
        "tooltip": [
          { "field": "Crop", "type": "nominal" },
          { "field": "Production (kt)", "type": "quantitative" }
        ]
      }
    }
  ]
}