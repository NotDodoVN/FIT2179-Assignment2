{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 400,
  "height": 225,
  "title": {
    "text": "Water Use by Sector (2022-23) in Australia",
    "subtitle": "Total: 10,634,566 ML (Megalitres)",
    "fontSize": 18,
    "fontWeight": "bold",
    "subtitleColor": "#e8e6e0",
    "anchor": "start"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/NotDodoVN/FIT2179-Assignment2/refs/heads/main/Datasets%20-%20wrangled/Graph%208%20-%20wrangled.csv"
  },
  "transform": [
    {
      "filter": "datum['Sectors'] !== 'Total industry' && datum['Sectors'] !== 'Total of all'"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 80,
        "outerRadius": 160
      },
      "encoding": {
        "theta": {
          "field": "Value (Megalitre)",
          "type": "quantitative",
          "aggregate": "sum"
        },
        "color": {
          "field": "Sectors",
          "type": "nominal",
          "legend": { "title": "Sectors" },
          "scale": {
            "domain":[
              "Agriculture",
              "Electricity",
              "Manufacturing",
              "Mining",
              "Other industries"
            ]
            ,
            "range": 
            [
              "#1B69AD",
              "#3887C0",
              "#5BA3CF",
              "#86BCDC",
              "#AFD1E7"
            ]
          }
          
        },
        "tooltip": [
          { "field": "Sectors", "type": "nominal" },
          {
            "field": "Value (Megalitre)",
            "type": "quantitative",
            "aggregate": "sum",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "radius": 0,
        "fontSize": 18,
        "fontWeight": "bold",
        "align": "center",
        "baseline": "middle",
        "color": "#e8e6e0"
      },
      "encoding": {
        "text": {
          "field": "Value (Megalitre)",
          "type": "quantitative",
          "aggregate": "sum",
          "format": ",.0f"
        }
      }
    }
  ],
  "view": { "stroke": null }
}