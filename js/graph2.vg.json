{
      "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
      "title": {
        "text": "Australia Emissions towards the Paris Convention's Goal",
        "anchor": "start",
        "subtitle": "MtCO₂e",
        "fontSize": 14,
        "subtitleFontSize": 11,
        "color": "#e8e6e0",
        "subtitleColor": "#e8e6e0"
      },
      "width": 400,
      "height": 225,
      "data": {
        "url": "https://raw.githubusercontent.com/NotDodoVN/FIT2179-Assignment2/refs/heads/main/Datasets%20-%20wrangled/Graph_2%20-%20Copy.csv"
      },
      "layer": [
        {
          "transform": [
            {"calculate": "year(datum['Financial Year'])", "as": "year"},
            {"filter": "datum.year <= 2024"},
            {"calculate": "'Historical Emissions'", "as": "series"}
          ],
          "mark": {"type": "line"},
          "encoding": {
            "x": {
              "field": "Financial Year",
              "type": "temporal",
              "axis": {"format": "%Y"}
            },
            "y": {"field": "Total UNFCCC (Mt)", "type": "quantitative", "title": "Total UNFCCC (MtCO₂e)"},
            "color": {
              "field": "series",
              "type": "nominal",
              "scale": {
                "domain": ["Historical Emissions", "Projected Emissions"],
                "range": ["steelblue", "green"]
              },
              "legend": {"title": "Legend"}
            }
          }
        },
        {
          "transform": [
            {"calculate": "year(datum['Financial Year'])", "as": "year"},
            {"filter": "datum.year > 2024"},
            {"calculate": "'Projected Emissions'", "as": "series"}
          ],
          "mark": {"type": "line", "strokeDash": [6, 4]},
          "encoding": {
            "x": {"field": "Financial Year", "type": "temporal"},
            "y": {"field": "Total UNFCCC (Mt)", "type": "quantitative"},
            "color": {
              "field": "series",
              "type": "nominal",
              "scale": {
                "domain": ["Historical Emissions", "Projected Emissions"],
                "range": ["steelblue", "green"]
              },
              "legend": {"title": "Legend"}
            }
          }
        },
        {
          "mark": {"type": "point", "opacity": 0},
          "encoding": {
            "x": {"field": "Financial Year", "type": "temporal"},
            "y": {"field": "Total UNFCCC (Mt)", "type": "quantitative"},
            "tooltip": [
              {
                "field": "Financial Year",
                "type": "temporal",
                "format": "%Y",
                "title": "Year"
              },
              {
                "field": "Total UNFCCC (Mt)",
                "type": "quantitative",
                "format": ",.2f",
                "title": "Emissions (MtCO₂)"
              }
            ]
          }
        }
      ]
    }