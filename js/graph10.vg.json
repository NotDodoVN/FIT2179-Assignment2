{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 400,
  "height": 225,
  "title": {
    "text": "Crop Production and Year-on-Year Change (2024-25)",
    "subtitle": "Bars show production volume (kt); line shows percentage change from prior year",
    "fontSize": 16,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "subtitleColor": "gray",
    "anchor": "start"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/NotDodoVN/FIT2179-Assignment2/refs/heads/main/Datasets%20-%20wrangled/Graph%2010%20-%20Wrangled%20(24-25).csv"
  },
  "resolve": {
    "scale": { "y": "independent" }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#4C78A8",
        "cornerRadiusTopLeft": 4,
        "cornerRadiusTopRight": 4
      },
      "encoding": {
        "x": {
          "field": "Crop",
          "type": "nominal",
          "axis": { "title": "Crop", "labelAngle": 0 }
        },
        "y": {
          "field": "Production kt",
          "type": "quantitative",
          "axis": {
            "title": "Production (kt)",
            "titleColor": "#4C78A8"
          }
        },
        "tooltip": [
          { "field": "Crop", "type": "nominal" },
          { "field": "Production kt", "type": "quantitative" }
        ]
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#F58518",
        "strokeWidth": 2.5,
        "point": {
          "filled": true,
          "fill": "#F58518",
          "size": 80
        }
      },
      "encoding": {
        "x": {
          "field": "Crop",
          "type": "nominal"
        },
        "y": {
          "field": "Production Change (%)",
          "type": "quantitative",
          "axis": {
            "title": "Production Change (%)",
            "titleColor": "#F58518"
          }
        },
        "tooltip": [
          { "field": "Crop", "type": "nominal" },
          { "field": "Production Change (%)", "type": "quantitative" }
        ]
      }
    }
  ],
  "width": 500,
  "height": 350
}