{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 400,
  "height": 225,
  "title": {
    "text": "Crop Production and Year-on-Year Change (2024-25)",
    "subtitle": "Bars show production volume (kt)",
    "fontSize": 16,
    "fontWeight": "bold",
    "subtitleFontSize": 12,
    "subtitleColor": "#e8e6e0",
    "anchor": "start"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/NotDodoVN/FIT2179-Assignment2/refs/heads/main/Datasets%20-%20wrangled/Graph%2010%20-%20Wrangled%20(24-25).csv"
  },
  "resolve": {"scale": {"y": "independent"}},
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#4C78A8",
        "cornerRadiusTopLeft": 4,
        "cornerRadiusTopRight": 4
      },
      "encoding": {
        "x": {
          "field": "Crop",
          "type": "nominal",
          "axis": {"title": "Crop", "labelAngle": 0}
        },
        "y": {
          "field": "Production kt",
          "type": "quantitative",
          "scale": {"domain": [0, 4000]},
          "axis": {
            "title": "Production (kt)",
            "titleColor": "#4C78A8",
            "values": [0, 1000, 2000, 3000, 4000]
          }
        },
        "tooltip": [
          {"field": "Crop", "type": "nominal"},
          {"field": "Production kt", "type": "quantitative"}
        ]
      }
    }
  ]
}