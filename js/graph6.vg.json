{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Polar chart of Australian bushfire incidents by state, log base-5 scaled radius, styled for dark fire-theme website.",
  "title": {
    "text": "Bushfire Incidents by State & Period",
    "subtitle": "Radius = log₅(incidents)  ·  inner = 2011–16  ·  outer = 2016–21",
    "anchor": "start",
    "fontSize": 13,
    "subtitleFontSize": 11,
    "font": "'Playfair Display', serif",
    "subtitleFont": "'DM Sans', sans-serif",
    "color": "#e8e6e0",
    "subtitleColor": "#e8e6e0",
    "offset": 10
  },
  "background": "transparent",
  "width": 300,
  "height": 270,
  "data": {
    "values": [
      {"State": "ACT",  "Period": "2011–16", "Incidents": 17,    "Log5": 1.760},
      {"State": "ACT",  "Period": "2016–21", "Incidents": 87,    "Log5": 2.775},
      {"State": "NSW",  "Period": "2011–16", "Incidents": 1766,  "Log5": 4.645},
      {"State": "NSW",  "Period": "2016–21", "Incidents": 5635,  "Log5": 5.366},
      {"State": "NT",   "Period": "2011–16", "Incidents": 45565, "Log5": 6.665},
      {"State": "NT",   "Period": "2016–21", "Incidents": 34718, "Log5": 6.496},
      {"State": "Qld",  "Period": "2011–16", "Incidents": 49902, "Log5": 6.721},
      {"State": "Qld",  "Period": "2016–21", "Incidents": 30323, "Log5": 6.412},
      {"State": "SA",   "Period": "2011–16", "Incidents": 302,   "Log5": 3.548},
      {"State": "SA",   "Period": "2016–21", "Incidents": 217,   "Log5": 3.343},
      {"State": "Tas.", "Period": "2011–16", "Incidents": 208,   "Log5": 3.316},
      {"State": "Tas.", "Period": "2016–21", "Incidents": 234,   "Log5": 3.390},
      {"State": "Vic.", "Period": "2011–16", "Incidents": 1025,  "Log5": 4.307},
      {"State": "Vic.", "Period": "2016–21", "Incidents": 1878,  "Log5": 4.684},
      {"State": "WA",   "Period": "2011–16", "Incidents": 7022,  "Log5": 5.503},
      {"State": "WA",   "Period": "2016–21", "Incidents": 4334,  "Log5": 5.203}
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 14,
        "stroke": "#1a1a20",
        "strokeWidth": 1.5
      },
      "encoding": {
        "theta": {
          "field": "State",
          "type": "nominal",
          "sort": ["ACT", "NSW", "NT", "Qld", "SA", "Tas.", "Vic.", "WA"],
          "stack": true,
          "band": 1
        },
        "radius": {
          "field": "Log5",
          "type": "quantitative",
          "scale": {
            "type": "linear",
            "domain": [0, 7.0],
            "rangeMin": 14,
            "rangeMax": 130
          }
        },
        "color": {
          "field": "Period",
          "type": "nominal",
          "scale": {
            "domain": ["2011–16", "2016–21"],
            "range": ["#c9943a", "#e85d26"]
          },
          "legend": {
            "title": "Period",
            "orient": "bottom",
            "direction": "horizontal",
            "titleFontSize": 10,
            "titleFont": "'DM Sans', sans-serif",
            "titleColor": "#8a8a96",
            "labelFont": "'DM Mono', monospace",
            "labelFontSize": 10,
            "labelColor": "#8a8a96",
            "symbolSize": 80,
            "symbolType": "circle",
            "offset": 12,
            "padding": 6,
            "titlePadding": 4
          }
        },
        "opacity": {
          "condition": {"param": "hover", "value": 1},
          "value": 0.85
        },
        "order": {
          "field": "Period",
          "sort": ["2011–16", "2016–21"]
        },
        "tooltip": [
          {"field": "State",     "type": "nominal",      "title": "State"},
          {"field": "Period",    "type": "nominal",      "title": "Period"},
          {"field": "Incidents", "type": "quantitative", "title": "Incidents",       "format": ","}
        ]
      },
      "params": [
        {
          "name": "hover",
          "select": {"type": "point", "on": "mouseover", "clear": "mouseout"}
        }
      ]
    },
    {
      "transform": [
        {"filter": {"field": "Period", "equal": "2016–21"}}
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "font": "'DM Mono', monospace",
        "color": "#8a8a96",
        "radiusOffset": 100
      },
      "encoding": {
        "theta": {
          "field": "State",
          "type": "nominal",
          "sort": ["ACT", "NSW", "NT", "Qld", "SA", "Tas.", "Vic.", "WA"],
          "stack": true,
          "band": 0.5
        },
        "radius": {"value": 143},
        "text": {"field": "State", "type": "nominal"}
      }
    }
  ],
  "view": {"stroke": "transparent", "fill": "transparent"},
  "config": {
    "background": "transparent",
    "arc": {"padAngle": 0.03},
    "font": "'DM Sans', sans-serif",
    "legend": {
      "orient": "bottom",
      "direction": "horizontal",
      "titleColor": "#8a8a96",
      "labelColor": "#8a8a96",
      "titleFont": "'DM Sans', sans-serif",
      "labelFont": "'DM Mono', monospace",
      "titleFontSize": 10,
      "labelFontSize": 10,
      "symbolSize": 80,
      "symbolType": "circle",
      "offset": 12
    }
  }
}