{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Radial Chart - Bush Fires by State",
  "title": {
        "text": "Proportion of bushfires by States",
        "anchor": "start",
        "subtitle": "In Australia",
        "fontSize": 14,
        "subtitleFontSize": 11,
        "color": "#e8e6e0",
        "subtitleColor": "#e8e6e0"
      },
  "width": 400,
  "height": 225,

  "data": {
    "url": "https://raw.githubusercontent.com/NotDodoVN/FIT2179-Assignment2/refs/heads/main/Datasets%20-%20wrangled/Graph_6_wrangled_to_use.csv"
  },

  "transform": [
    {
      "filter": "datum.States !== 'All States'"
    },
    {
      "fold": ["2011-12 to 2015-16", "2016-17 to 2020-21"],
      "as": ["Period", "Value"]
    },
    {
      "calculate": "toNumber(replace(datum.Value, ',', ''))",
      "as": "ValueNum"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 30,
        "stroke": "white",
        "strokeWidth": 1.5
      },

      "encoding": {
        "theta": {
          "field": "States",
          "type": "nominal",
          "sort": ["NT", "Qld", "WA", "NSW", "Vic.", "SA", "Tas.", "ACT"],
          "stack": true,
          "band": 1
        },

        "radius": {
          "field": "ValueNum",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "rangeMin": 32,
            "rangeMax": 165
          }
        },

        "color": {
          "field": "Period",
          "type": "nominal",

          "scale": {
            "domain": ["2011-12 to 2015-16", "2016-17 to 2020-21"],
            "range": ["#e07b39", "#3a75c4"]
          },

          "legend": {
            "title": "Period",
            "orient": "right",
            "direction": "vertical",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "symbolType": "circle",
            "padding": 10
          }
        },

        "tooltip": [
          {
            "field": "States",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "Period",
            "type": "nominal",
            "title": "Period"
          },
          {
            "field": "ValueNum",
            "type": "quantitative",
            "title": "Fire Count",
            "format": ","
          }
        ]
      }
    },
    {
  "transform": [
    {
      "filter": "datum.Period === '2011-12 to 2015-16'"
    }
  ],

  "mark": {
    "type": "text",
    "radiusOffset": 4,
    "fontSize": 11,
    "fontWeight": "bold",
    "color": "#898995"
  },

  "encoding": {
    "theta": {
      "field": "States",
      "type": "nominal",
      "sort": ["NT", "Qld", "WA", "NSW", "Vic.", "SA", "Tas.", "ACT"],
      "band": 0.5
    },

    "radius": {
      "value": 210
    },

    "text": {
      "field": "States",
      "type": "nominal"
    }
  }
    
  }
]
}